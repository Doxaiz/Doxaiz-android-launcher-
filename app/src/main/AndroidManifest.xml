<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.doxaiz.launcher"
    android:versionCode="38"
    android:versionName="5.5-test">

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <!-- Отображение всех установленных приложений на Android 11+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Пункт «Удалить приложение» в меню иконки -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Жест свайпа вниз для шторки уведомлений -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Чтение статуса сети для авто-перепроверки при залипании (без доступа в интернет!) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Системный отпечаток пальца / PIN для приватного пространства скрытых приложений -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Завершение фоновых кэшированных процессов в окне «Активные приложения» -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Опциональное системное управление яркостью, автоповоротом и тайм-аутом экрана из шторки (выдаётся вручную) -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Опциональное переключение режима «Не беспокоить» и «Без звука» из шторки и панели звука (выдаётся вручную) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Опциональный импорт раскладки из XOS / штатной оболочки (если прошивка разрешает) -->
    <uses-permission android:name="com.transsion.XOSLauncher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.transsion.hilauncher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.transsion.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.transsion.magiclauncher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.android.launcher3.permission.READ_SETTINGS" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/DoxaizTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="mcc|mnc|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Опциональная служба только для жеста «двойной тап -> выключить экран» (Android 9+) -->
        <service
            android:name=".DoxaizLockService"
            android:exported="false"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/doxaiz_lock_service" />
        </service>

        <!-- Опциональная служба читает уведомления для шторки, ответов и значков после разрешения пользователя -->
        <service
            android:name=".DoxaizNotificationService"
            android:exported="false"
            android:label="@string/notif_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
