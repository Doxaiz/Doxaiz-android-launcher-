<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.doxaiz.launcher">

    <!-- minSdk/targetSdk и versionCode/versionName задаются только в app/build.gradle:
         build.sh передаёт их в aapt2 link флагами min-sdk-version/target-sdk-version/
         version-code/version-name, поэтому дублировать их здесь не нужно.
         Важно: двойной дефис внутри XML-комментария запрещён стандартом, поэтому
         названия флагов здесь пишутся без ведущих дефисов. -->

    <!-- Отображение всех установленных приложений на Android 11+ -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Пункт «Удалить приложение» в меню иконки -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Жест свайпа вниз для шторки уведомлений -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Чтение статуса сети для авто-перепроверки при залипании. Лаунчер остаётся
         без INTERNET: замер скорости и работа с интернетом — отдельное приложение
         net-optimizer-by_doxaiz (AUDIT §29.5). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Перепроверка канала: ConnectivityManager.reportNetworkConnectivity() требует
         CHANGE_NETWORK_STATE (protection level normal, выдаётся при установке) ЛИБО
         права менять системные настройки. Без этой строки вызов падал с
         SecurityException, который молча проглатывался, и «улучшение сети» не
         работало никогда — см. AUDIT §29. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Системный отпечаток пальца / PIN для приватного пространства скрытых приложений -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Завершение фоновых кэшированных процессов в окне «Активные приложения» -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Опциональное системное управление яркостью, автоповоротом и тайм-аутом экрана из шторки.
         Разрешение не «выдаётся вручную» в обычном смысле: пользователь отдельно
         разрешает его в Settings.ACTION_MANAGE_WRITE_SETTINGS, приложение при этом
         НЕ становится системным. tools:ignore нужен, потому что Lint относит
         защищённые разрешения к «только для системных приложений»; для WRITE_SETTINGS
         это неверно, и ниже это проверяется. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Опциональное переключение режима «Не беспокоить» и «Без звука» из шторки и панели звука (выдаётся вручную) -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Опциональный импорт раскладки из XOS / штатной оболочки (если прошивка разрешает) -->
    <uses-permission android:name="com.transsion.XOSLauncher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.transsion.hilauncher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.transsion.launcher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.transsion.magiclauncher.permission.READ_SETTINGS" />
    <uses-permission android:name="com.android.launcher3.permission.READ_SETTINGS" />

    <!-- Shizuku присылает свой binder в провайдер приложения: это единственный
         штатный способ получить shell-доступ, если человек уже запустил Shizuku
         через ADB/root. Разрешение INTERACT_ACROSS_USERS_FULL выдано только
         shell, поэтому провайдер доступен лишь Shizuku и нашему процессу. -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/DoxaizTheme"
        android:usesCleartextTraffic="false"
        tools:targetApi="33">
        <!-- enableOnBackInvokedCallback действует только с Android 13 (API 33).
             Атрибут объявлен здесь, потому что манифест один для всех версий;
             tools:targetApi сообщает Lint, что атрибут сознательно объявлен
             при minSdk 26 — на старых версиях система просто его игнорирует. -->

        <!-- Портретная ориентация — осознанное решение: сетка рабочего стола,
             папки и карусель рассчитаны на вертикальный экран (Chrome OS/планшет
             в ландшафте не целевая конфигурация). tools:ignore фиксирует это,
             чтобы предупреждение не терялось среди прочих. -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="mcc|mnc|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Аварийный экран (F-22): показывается вместо рабочего стола, если
             лаунчер дважды подряд не смог стартовать. Отдельная активность, а не
             диалог, потому что при падении при построении интерфейса показать
             диалог некому. exported="false": запускается только изнутри
             приложения. Своего фильтра HOME у неё нет намеренно: фильтр ACTION_MAIN
             + CATEGORY_HOME сделал бы её вторым «домашним экраном» приложения, и
             система показала бы выбор «Doxaiz / Doxaiz» после аварии. Пока
             аварийный экран открыт, MAIN/LAUNCHER-фильтр MainActivity всё равно
             возвращает пользователя в этот же task. -->
        <!-- Приём binder'а от Shizuku. Authority задан литералом осознанно:
             подстановка ${applicationId} — возможность Gradle, а проект
             собирается ещё и build.sh через aapt2 напрямую, где подстановок
             нет. Имя пакета зафиксировано в манифесте выше. -->
        <provider
            android:name=".ShizukuProvider"
            android:authorities="com.doxaiz.launcher.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity
            android:name=".SafeModeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            tools:ignore="LockedOrientationActivity">
        </activity>

        <!-- Опциональная служба только для жеста «двойной тап -> выключить экран» (Android 9+).
             exported="true" обязателен: службу биндит системный процесс (system_server),
             доступ при этом закрыт разрешением BIND_ACCESSIBILITY_SERVICE, которое
             выдаётся только системе. С exported="false" привязка отклоняется
             на части прошивок, и панель ОЗУ/жест молча не работают. -->
        <service
            android:name=".DoxaizLockService"
            android:exported="true"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/doxaiz_lock_service" />
        </service>

        <!-- Опциональная служба читает уведомления для шторки, ответов и значков после разрешения пользователя -->
        <service
            android:name=".DoxaizNotificationService"
            android:exported="false"
            android:label="@string/notif_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
