<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила резервного копирования для Android 12 (API 31) и выше.

  allowBackup="false" продолжает работать, но с Android 12 система дополнительно
  спрашивает dataExtractionRules. Здесь запрещены оба канала: облачная копия и
  перенос на новое устройство. Лаунчер хранит раскладку, журнал запусков и
  список скрытых приложений — выносить это в облако без явного согласия
  пользователя нельзя, а собственный экспорт в JSON у приложения уже есть.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
