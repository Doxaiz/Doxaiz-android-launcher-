<?xml version="1.0" encoding="utf-8"?>
<!--
  Конфигурация Android Lint для Doxaiz.

  Порог: ошибки валят сборку, предупреждения — нет (иначе красный CI отражал бы
  стилистику, а не дефекты). Исключены только проверки, которые для лаунчера
  заведомо неприменимы или требуют решения уровня магазина приложений.
-->
<lint>
    <!--
      QUERY_ALL_PACKAGES: лаунчер по определению обязан видеть список приложений,
      иначе ему нечего показывать. Это осознанное решение, к тому же отмеченное
      в манифесте. Политика Google Play требует отдельного обоснования при
      публикации в магазине — это процесс, а не правка кода.
    -->
    <issue id="QueryAllPackagesPermission" severity="ignore" />

    <!--
      Обновление локализованных строк/иконок: проект пока одноязычный (русский),
      ресурсы для других локалей отсутствуют намеренно.
    -->
    <issue id="MissingTranslation" severity="ignore" />
    <issue id="MissingDefaultResource" severity="ignore" />

    <!-- Векторные иконки генерируются кодом (VectorGlyphs), не из ресурсов. -->
    <issue id="VectorRaster" severity="ignore" />

    <!-- Мы принципиально не используем сторонние библиотеки: правило про Gradle-плагины неактуально. -->
    <issue id="GradleDependency" severity="ignore" />
</lint>
